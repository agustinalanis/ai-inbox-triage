# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local Postgres from docker-compose.yml (local dev credentials only)
DATABASE_URL=postgresql://inbox:inbox@localhost:5432/inbox_triage
# Host port for that Postgres; change it (and DATABASE_URL) if 5432 is taken
# POSTGRES_PORT=5432

# Optional, with their defaults
# PORT=3000
# WEB_ORIGIN=http://localhost:5173
# DAILY_MESSAGE_LIMIT=300

# Web: API base URL, read by Vite from apps/web/.env (defaults to http://localhost:3000)
# VITE_API_URL=http://localhost:3000
